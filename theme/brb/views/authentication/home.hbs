{{#extend "lib/default"}}
{{#content "styles" mode="append"}}
<link rel="stylesheet" href="{{getAssetPath '/styles/authentication/home.css'}}" />
<link rel="stylesheet" href="{{getAssetPath '/styles/authentication/home-login.css'}}" />
<link rel="stylesheet" href="{{getAssetPath '/styles/lib/header.css'}}"/>
{{/content}}
{{#content "scripts" mode="append"}}
<script src="{{getAssetPath '/scripts/login.js'}}" type="text/javascript" nonce="{{nonceValue}}" defer></script>
<script src="{{getAssetPath '/scripts/header.js'}}" type="text/javascript" nonce="{{nonceValue}}" defer></script>
{{/content}} {{#content "body"}} {{#embed "lib/header" hideMenu=true}}{{/embed}}
<div class="container">
	<div class="row">
		<main id="main-content" class="col-md-8">
			<div class="hidden-md-up">
				{{> "authentication/forms/login"}}
			</div>

			<section class="card">
				<div class="card-block">
					<!-- GLOBAL_ANNOUNCEMENT -->
					{{#hasConfig "GLOBAL_ANNOUNCEMENT"}}
					<div class="notification alert alert-info">
						<div class="notification-content">
							{{{getConfig "GLOBAL_ANNOUNCEMENT"}}}
						</div>
					</div>
					{{/hasConfig}}
					
					<h4>{{$t "landingPage.label.welcome" (dict "shortTitle" theme.short_title)}}</h4>
					<p>{{{$t "landingPage.brb.text.welcome" (dict "shortTitle" theme.short_title)}}}</p>
					<p>{{{$t "landingPage.brb.text.welcome2" (dict "shortTitle" theme.short_title)}}}</p>
					<h4>{{$t "landingPage.brb.headline.registration" (dict "shortTitle" theme.short_title)}}</h4>
					<p>{{{$t "landingPage.brb.text.registration" (dict "shortTitle" theme.short_title)}}}</p>
					<p>{{{$t "landingPage.brb.text.registration2" (dict "shortTitle" theme.short_title)}}}</p>
					<h4>{{$t "landingPage.brb.headline.advantages" (dict "shortTitle" theme.short_title)}}</h4>
					<ul>{{{$t "landingPage.brb.text.advantages" (dict "shortTitle" theme.short_title)}}}</ul>
					<p>
						<img src="https://cloud-instances.s3.hidrive.strato.com/brb/images/HPI_Schul_Cloud_Brandenburg_Schueler_2019.jpg"
							alt="{{$t "landingPage.brb.img_alt.text" (dict "shortTitle" theme.short_title)}}" 
							/>
					</p>
					<h4>{{$t "landingPage.brb.headline.valueStatement" (dict "shortTitle" theme.short_title)}}</h4>
					<ul>{{{$t "landingPage.brb.text.valueStatement" (dict "shortTitle" theme.short_title)}}}</ul>
				</div>
			</section>
		</main>
		<aside class="col-md-4">
			<div class="hidden-sm-down">
				{{> "authentication/forms/login"}}
			</div>

			<section class="card">
				<div class="card-block">
					<h4>{{$t "landingPage.brb.headline.generalInquiriesSupport" (dict "shortTitle" theme.short_title)}}</h4>
				    <ul>
						<li>{{{$t "landingPage.brb.text.phone1"}}}</li>
						<li>{{{$t "landingPage.brb.text.email"}}}</li>
					</ul>
				</div>
			</section>

			<section id="furtherInformation" class="card">
				<div class="card-block">
					<h4>{{$t "landingPage.brb.headline.furtherInformation" (dict "shortTitle" theme.short_title)}}</h4>
                    <p>{{{$t "landingPage.brb.text.furtherInformation"}}}</p>
				</div>
			</section>

			<section id="partner" class="card">
				<div class="card-block">
					<h4 class="card-title">Projektdurchführung</h4>
					<div class="card-text partner-img">
						<a href="https://mbjs.brandenburg.de" target="_blank" rel="noopener">
							<img src="https://cloud-instances.s3.hidrive.strato.com/brb/images/mbjs.png" alt="Logo MBJS"
								class="img-fluid">
						</a>
						<a href="https://libra.brandenburg.de" target="_blank" rel="noopener">
							<img src="https://cloud-instances.s3.hidrive.strato.com/brb/images/libra.png"
								alt="Logo Libra" class="img-fluid">
						</a>
						<a href="https://fwu.de" target="_blank" rel="noopener">
							<img src="{{getAssetPath '/images/fwu-logo.svg'}}" alt="Logo FWU" class="img-fluid"
								style="display: block; max-width: 160px; margin: 0 auto;">
						</a>
					</div>
				</div>
			</section>

			<section id="funding" class="card">
				<div class="card-block">
					<p class="mb-1" aria-hidden="true">Gefördert durch:</p>
					<img src="{{getAssetPath '/images/bmbfsfj-logo.svg'}}" class="img-fluid mb-1"
						alt="Gefördert durch Bundesministerium für Bildung, Familie, Senioren, Frauen und Jugend aufgrund eines Beschlusses des Deutschen Bundestages">
					<p class="mb-0" aria-hidden="true">aufgrund eines Beschlusses des Deutschen Bundestages</p>
				</div>
			</section>
		</aside>
	</div>
</div>

{{#embed "lib/extended_footer"}}{{/embed}} {{#embed "lib/components/modal-form" action="/pwrecovery/" method="post"
class="pwrecovery-modal"}}
{{#content "fields"}} {{> "authentication/forms/pwrecovery"}} {{/content}} {{/embed}} {{/content}} {{/extend}}
