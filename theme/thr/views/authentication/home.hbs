{{#extend "lib/loggedout"}}

{{#content "styles" mode="append"}}
	<link rel="stylesheet" href="{{getAssetPath '/styles/homepage/index.css'}}" />
{{/content}}

{{#content "scripts" mode="append"}}
	<script src="{{getAssetPath '/scripts/login.js'}}" type="text/javascript" nonce="{{nonceValue}}" defer></script>
{{/content}}

{{#content "page"}}

{{#embed "authentication/section"}}
	{{#content "body"}}
		<div class="rows-2">
			<div>
				<h1 class="h4">{{$t "landingPage.label.welcome" (dict "shortTitle" theme.short_title)}}</h1>
				<p>{{{$t "landingPage.thr.text.welcome" (dict "shortTitle" theme.short_title)}}}</p>
			</div>

			<div>
				{{> "authentication/forms/login"}}
			</div>
		</div>
	{{/content}}
{{/embed}}

{{#embed "lib/components/modal-form" action="/pwrecovery/" method="post" class="pwrecovery-modal"}}
	{{#content "fields"}}
		{{> "authentication/forms/pwrecovery"}}
	{{/content}}
{{/embed}}


	{{/content}}
{{/extend}}
