<div class="error-header-wrapper pb-3">
    {{> 'lib/components/svg_error_content' }}
    <h1 class="h2">{{$t "lib.csrf_content.headline.continueFromHome" }}</h1>
    <p class="error-header-text">
        {{$t "lib.csrf_content.text.weCouldNotMakeSureThatThisRequestReallyCameFromYou" }}
    </p>

    <div class="noiframe">
        <a class="btn btn-primary" href="/">{{$t "global.link.landing" }}</a>
    </div>
    <div class="hidden iframe">
        <p>{{$t "lib.csrf_content.text.theSchoolCloudWasEmbedded" }}</p>
        <a class="btn btn-primary" href="/" target="_blank" rel="noopener noreferrer">{{$t "lib.csrf_content.link.openHomePageInNewTab" }}</a>
    </div>
</div>
